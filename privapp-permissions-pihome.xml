<?xml version="1.0" encoding="utf-8"?>
<!-- installed to /system/etc/permissions/; must list every privileged permission the
     manifest requests, or the Pi will not boot (ro.control_privapp_permissions=enforce) -->
<permissions>
    <privapp-permissions package="com.sall.pihome">
        <permission name="com.android.providers.tv.permission.ACCESS_ALL_EPG_DATA" />
        <permission name="android.permission.MEDIA_CONTENT_CONTROL" />
        <permission name="android.permission.PACKAGE_USAGE_STATS" />
    </privapp-permissions>
</permissions>
